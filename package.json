{
  "name": "agentz",
  "private": true,
  "version": "0.0.0",
  "description": "AgentZ Suite - local desktop tools for content creators.",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:tooling && pnpm -r --if-present test",
    "dev:scriptz": "pnpm --filter @agentz/scriptz-app tauri:dev",
    "build:scriptz": "pnpm --filter @agentz/scriptz-app tauri:build",
    "lint": "eslint .",
    "test:tooling": "node --test tooling/checks/*.test.mjs tooling/release/*.test.mjs tooling/new-app/*.test.mjs",
    "check:colors": "node tooling/checks/colors.mjs",
    "check:sync-format": "node tooling/checks/sync-format.mjs",
    "build:frontends": "pnpm --filter './apps/*' --if-present build",
    "release:bump": "node tooling/release/bump.mjs",
    "dev:site": "pnpm --filter @agentz/site dev",
    "dev:site:backend": "pnpm --filter @agentz/site dev:backend",
    "build:site": "pnpm --filter @agentz/site build",
    "dev:bench": "pnpm --filter @agentz/bench dev",
    "build:bench": "pnpm --filter @agentz/bench build",
    "bench:agent": "pnpm --filter @agentz/scriptz bench:agent",
    "check:astro": "node tooling/checks/astro.mjs",
    "new-app": "node tooling/new-app/index.mjs create",
    "remove-app": "node tooling/new-app/index.mjs remove"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript-eslint": "8.71.0",
    "typescript": "catalog:",
    "@astrojs/compiler-rs": "0.5.0"
  }
}
