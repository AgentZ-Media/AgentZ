---
/**
 * VERGLEICH section - dedicated route (`/vergleich`, `/en/compare`).
 */
import { routePath, t, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="v2-tab-content is-active" data-content="vergleich" data-section-title={t(lang, "tab.compare.long")}>
  <h1 class="v2-block v2-action v2-scene">{t(lang, "cmp.caption")}</h1>

  <div class="v2-block v2-action">{t(lang, "cmp.action1")}</div>

  <div class="v2-table-wrap">
    <table class="v2-table">
      <thead>
        <tr>
          <th class="v2-table-crit">{t(lang, "cmp.head.crit")}</th>
          <th class="v2-table-us">SCRIPTZ</th>
          <th>Word / Docs</th>
          <th>Notion</th>
          <th>ChatGPT</th>
          <th>Final Draft</th>
          <th>Apple Notes</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="v2-table-crit">{t(lang, "cmp.row.format")}</td>
          <td class="v2-table-us"><span class="v2-mark yes">{t(lang, "cmp.mark.yes")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark meh">{t(lang, "cmp.mark.feature")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
        </tr>
        <tr>
          <td class="v2-table-crit">{t(lang, "cmp.row.quick")}</td>
          <td class="v2-table-us"><span class="v2-mark yes">{t(lang, "cmp.mark.yes")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
        </tr>
        <tr>
          <td class="v2-table-crit">{t(lang, "cmp.row.chars")}</td>
          <td class="v2-table-us"><span class="v2-mark yes">{t(lang, "cmp.mark.yes")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark yes">{t(lang, "cmp.mark.yes")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
        </tr>
        <tr>
          <td class="v2-table-crit">{t(lang, "cmp.row.short")}</td>
          <td class="v2-table-us"><span class="v2-mark yes">{t(lang, "cmp.mark.yes")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.featureNo")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
        </tr>
        <tr>
          <td class="v2-table-crit">{t(lang, "cmp.row.length")}</td>
          <td class="v2-table-us"><span class="v2-mark yes">{t(lang, "cmp.mark.yes")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark meh">{t(lang, "cmp.mark.pages")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
        </tr>
        <tr>
          <td class="v2-table-crit">{t(lang, "cmp.row.pipeline")}</td>
          <td class="v2-table-us"><span class="v2-mark yes">{t(lang, "cmp.mark.yes")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark meh">{t(lang, "cmp.mark.diy")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
        </tr>
        <tr>
          <td class="v2-table-crit">{t(lang, "cmp.row.noai")}</td>
          <td class="v2-table-us"><span class="v2-mark yes">{t(lang, "cmp.mark.yes")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.copilot")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.notionai")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.isai")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.beatai")}</span></td>
          <td><span class="v2-mark meh">{t(lang, "cmp.mark.appleint")}</span></td>
        </tr>
        <tr>
          <td class="v2-table-crit">{t(lang, "cmp.row.local")}</td>
          <td class="v2-table-us"><span class="v2-mark yes">{t(lang, "cmp.mark.yes")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.cloud")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.cloud")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.paid")}</span></td>
          <td><span class="v2-mark meh">{t(lang, "cmp.mark.appleonly")}</span></td>
        </tr>
        <tr>
          <td class="v2-table-crit">{t(lang, "cmp.row.fast")}</td>
          <td class="v2-table-us"><span class="v2-mark yes">{t(lang, "cmp.mark.yes")}</span></td>
          <td><span class="v2-mark meh">{t(lang, "cmp.mark.meh")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark no">{t(lang, "cmp.mark.no")}</span></td>
          <td><span class="v2-mark yes">{t(lang, "cmp.mark.yes")}</span></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="v2-block v2-action">{t(lang, "cmp.action2")}</div>

  <div class="v2-jump">
    <span class="v2-jump-label">{t(lang, "jump.label.short")}</span>
    <a class="v2-jump-btn" href={routePath(lang, "download")}>{t(lang, "jump.btn.download")}</a>
    <a class="v2-jump-btn" href={routePath(lang, "warum")}>{t(lang, "jump.btn.backToStart")}</a>
  </div>
</section>
