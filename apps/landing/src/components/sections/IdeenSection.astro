---
/**
 * IDEEN section - dedicated route (`/ideen`, `/en/ideas`). Static
 * replica of the app's ideas page: capture field, folder chips,
 * ideas grouped by time, and the detail panel of the selected idea
 * with "Start as script". Nothing here is interactive - it shows the
 * layout, the app does the rest.
 */
import { t, tFormat, type Lang, type StringKey } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type FolderId = "tutorials" | "compare" | "reels";

const folders: { id: FolderId; labelKey: StringKey; color: string }[] = [
  { id: "tutorials", labelKey: "ideas.folder.tutorials", color: "#e0791f" },
  { id: "compare", labelKey: "ideas.folder.compare", color: "#3a8ed4" },
  { id: "reels", labelKey: "ideas.folder.reels", color: "#c8a400" },
];

interface Idea {
  titleKey: StringKey;
  bodyKey: StringKey;
  ageKey: StringKey;
  folder: FolderId | null;
}

const thisWeek: Idea[] = [
  { titleKey: "ideas.sample.tutorial.title", bodyKey: "ideas.sample.tutorial.body", ageKey: "ideas.sample.tutorial.age", folder: "tutorials" },
  { titleKey: "ideas.sample.fd.title",       bodyKey: "ideas.sample.fd.body",       ageKey: "ideas.sample.fd.age",       folder: "compare" },
  { titleKey: "ideas.sample.word.title",     bodyKey: "ideas.sample.word.body",     ageKey: "ideas.sample.word.age",     folder: "compare" },
  { titleKey: "ideas.sample.noai.title",     bodyKey: "ideas.sample.noai.body",     ageKey: "ideas.sample.noai.age",     folder: null },
  { titleKey: "ideas.sample.reel.title",     bodyKey: "ideas.sample.reel.body",     ageKey: "ideas.sample.reel.age",     folder: "reels" },
];

const older: Idea[] = [
  { titleKey: "ideas.sample.length.title", bodyKey: "ideas.sample.length.body", ageKey: "ideas.sample.length.age", folder: "reels" },
];

const all = [...thisWeek, ...older];
const countIn = (id: FolderId | null) => all.filter((i) => i.folder === id).length;
const folderOf = (id: FolderId | null) => folders.find((f) => f.id === id) ?? null;

// The first idea is shown as selected, with its detail panel.
const selected = thisWeek[0];
const selectedFolder = folderOf(selected.folder);

const groups: { labelKey: StringKey; ideas: Idea[] }[] = [
  { labelKey: "ideas.group.week", ideas: thisWeek },
  { labelKey: "ideas.group.older", ideas: older },
];
---

<section class="v2-tab-content v2-ideas is-active" data-content="ideen">
  <div class="v2-ideas-head">
    <h1 class="v2-ideas-h">{t(lang, "ideas.h")}</h1>
    <span class="v2-ideas-meta">{tFormat(lang, "ideas.meta", { open: all.length, fresh: thisWeek.length })}</span>
  </div>
  <p class="v2-ideas-sub">{t(lang, "ideas.sub")}</p>

  <div class="v2-ideas-input">
    <span class="v2-ideas-input-plus" aria-hidden="true">+</span>
    <span class="v2-ideas-input-text">{t(lang, "ideas.input.placeholder")}</span>
    <kbd class="v2-ikbd">⏎</kbd>
    <span class="v2-ideas-input-hint">{t(lang, "ideas.input.hint")}</span>
  </div>

  <div class="v2-ideas-chips">
    <span class="v2-fchip is-active">{t(lang, "ideas.chip.all")} <em>{all.length}</em></span>
    {folders.map((f) => (
      <span class="v2-fchip"><i style={`background:${f.color}`}></i>{t(lang, f.labelKey)} <em>{countIn(f.id)}</em></span>
    ))}
    <span class="v2-fchip">{t(lang, "ideas.chip.none")} <em>{countIn(null)}</em></span>
    <span class="v2-ideas-filter">{t(lang, "ideas.filter.placeholder")} <kbd class="v2-ikbd">/</kbd></span>
  </div>

  <div class="v2-ideas-layout">
    <div class="v2-ideas-listwrap">
      {groups.map((g) => (
        <>
          <h2 class="v2-igrp-h">{t(lang, g.labelKey)} <em>{g.ideas.length}</em></h2>
          <ul class="v2-ilist">
            {g.ideas.map((idea) => {
              const f = folderOf(idea.folder);
              return (
                <li class:list={["v2-irow", idea === selected && "is-selected"]}>
                  <span class="v2-irow-ti">{t(lang, idea.titleKey)}</span>
                  <span class="v2-irow-nt">{t(lang, idea.bodyKey)}</span>
                  <span class="v2-irow-fo">
                    {f && <i style={`background:${f.color}`}></i>}
                    {f ? t(lang, f.labelKey) : ""}
                  </span>
                  <span class="v2-irow-ag">{t(lang, idea.ageKey)}</span>
                </li>
              );
            })}
          </ul>
        </>
      ))}
      <p class="v2-ideas-keys">
        <kbd class="v2-ikbd">↑</kbd><kbd class="v2-ikbd">↓</kbd> {t(lang, "ideas.keys.select")} ·
        <kbd class="v2-ikbd">⏎</kbd> {t(lang, "ideas.keys.edit")} ·
        <kbd class="v2-ikbd">⌘⏎</kbd> {t(lang, "ideas.keys.start")}
      </p>
    </div>

    <aside class="v2-idet">
      <div class="v2-idet-top">{t(lang, "ideas.detail.top")}</div>
      <div class="v2-idet-t">{t(lang, selected.titleKey)}</div>
      <p class="v2-idet-n">{t(lang, selected.bodyKey)}</p>
      <dl class="v2-idet-meta">
        <div>
          <dt>{t(lang, "ideas.detail.folder")}</dt>
          <dd>
            <span class="v2-fchip v2-fchip-sm">
              {selectedFolder && <i style={`background:${selectedFolder.color}`}></i>}
              {selectedFolder ? t(lang, selectedFolder.labelKey) : t(lang, "ideas.chip.none")}
            </span>
          </dd>
        </div>
        <div>
          <dt>{t(lang, "ideas.detail.created")}</dt>
          <dd><b>{t(lang, "ideas.detail.createdValue")}</b></dd>
        </div>
      </dl>
      <span class="v2-idet-start">{t(lang, "ideas.detail.start")} <kbd class="v2-ikbd v2-ikbd-inv">⌘⏎</kbd></span>
      <div class="v2-idet-foot">
        <span>{t(lang, "ideas.detail.move")}</span>
        <span>{t(lang, "ideas.detail.delete")}</span>
      </div>
    </aside>
  </div>

  <div class="v2-ideas-hint">
    <span class="v2-kbd-pill">⌘ I</span> {t(lang, "ideas.hint.before")}
  </div>
</section>
