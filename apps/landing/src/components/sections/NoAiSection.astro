---
/**
 * NO-AI section - dedicated route (`/keine-ki`, `/en/no-ai`).
 */
import { routePath, t, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="v2-tab-content is-active" data-content="no-ai" data-section-title={t(lang, "tab.noai.long")}>
  <h1 class="v2-block v2-action v2-scene">{t(lang, "noai.caption")}</h1>

  <div class="v2-block v2-action">{t(lang, "noai.action1")}</div>

  <div class="v2-block v2-character" data-speaker="AXEL"><span class="v2-t">AXEL</span></div>
  <div class="v2-block v2-parenthetical" data-speaker="AXEL"><span class="v2-t">{t(lang, "noai.axel1.paren")}</span></div>
  <div class="v2-block v2-dialog" data-speaker="AXEL"><span class="v2-t">{t(lang, "noai.axel1.dialog")}</span></div>

  <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
  <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">{t(lang, "noai.timo1.dialog")}</span></div>

  <div class="v2-block v2-character" data-speaker="AXEL"><span class="v2-t">AXEL</span></div>
  <div class="v2-block v2-dialog" data-speaker="AXEL"><span class="v2-t">{t(lang, "noai.axel2.dialog")}</span></div>

  <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
  <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">{t(lang, "noai.timo2.dialog")}</span></div>

  <div class="v2-block v2-action">{t(lang, "noai.beat")}</div>

  <div class="v2-noai-grid">
    <div class="v2-noai-card">
      <span class="v2-noai-icon" aria-hidden="true">×</span>
      <h2>{t(lang, "noai.card1.title")}</h2>
      <p>{t(lang, "noai.card1.body")}</p>
    </div>
    <div class="v2-noai-card">
      <span class="v2-noai-icon" aria-hidden="true">×</span>
      <h2>{t(lang, "noai.card2.title")}</h2>
      <p>{t(lang, "noai.card2.body")}</p>
    </div>
    <div class="v2-noai-card">
      <span class="v2-noai-icon" aria-hidden="true">×</span>
      <h2>{t(lang, "noai.card3.title")}</h2>
      <p>{t(lang, "noai.card3.body")}</p>
    </div>
    <div class="v2-noai-card v2-noai-card-yes">
      <span class="v2-noai-icon-yes" aria-hidden="true">✓</span>
      <h2>{t(lang, "noai.card4.title")}</h2>
      <p>{t(lang, "noai.card4.body")}</p>
    </div>
  </div>

  <div class="v2-jump">
    <span class="v2-jump-label">{t(lang, "jump.label.short")}</span>
    <a class="v2-jump-btn" href={routePath(lang, "vergleich")}>{t(lang, "jump.btn.compareShort")}</a>
    <a class="v2-jump-btn" href={routePath(lang, "download")}>{t(lang, "jump.btn.download")}</a>
  </div>
</section>
