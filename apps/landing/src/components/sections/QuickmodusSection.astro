---
/**
 * QUICKMODUS section - dedicated route (`/quickmodus`,
 * `/en/quick-mode`). Caption is H1 because this is the only H1 on
 * this page (no hero).
 */
import { routePath, t, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="v2-tab-content is-active" data-content="quickmodus" data-section-title={t(lang, "tab.quickmodus.long")}>
  <h1 class="v2-block v2-action v2-scene">{t(lang, "quick.caption")}</h1>

  <div class="v2-block v2-action">{t(lang, "quick.action1")}</div>

  <div class="v2-block v2-action">{t(lang, "quick.beat")}</div>

  <div class="v2-block v2-action">{t(lang, "quick.action2")}</div>

  <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
  <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">{t(lang, "quick.timo1.dialog")}</span></div>

  <div class="v2-block v2-character" data-speaker="AXEL"><span class="v2-t">AXEL</span></div>
  <div class="v2-block v2-dialog" data-speaker="AXEL"><span class="v2-t">{t(lang, "quick.axel1.dialog")}</span></div>

  <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
  <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">{t(lang, "quick.timo2.dialog")}</span></div>

  <div class="v2-block v2-character" data-speaker="AXEL"><span class="v2-t">AXEL</span></div>
  <div class="v2-block v2-dialog" data-speaker="AXEL"><span class="v2-t">{t(lang, "quick.axel2.dialog")}</span></div>

  <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
  <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">{t(lang, "quick.timo3.dialog")}</span></div>

  <div class="v2-block v2-action">{t(lang, "quick.action3")}</div>

  <div class="v2-callout">
    <span class="v2-callout-eyebrow">{t(lang, "quick.callout.eyebrow")}</span>
    <p>{t(lang, "quick.callout.body")}</p>
  </div>

  <div class="v2-jump">
    <span class="v2-jump-label">{t(lang, "jump.label.short")}</span>
    <a class="v2-jump-btn" href={routePath(lang, "no-ai")}>{t(lang, "jump.btn.noaiAlt")}</a>
    <a class="v2-jump-btn" href={routePath(lang, "vergleich")}>{t(lang, "jump.btn.compareShort")}</a>
    <a class="v2-jump-btn" href={routePath(lang, "download")}>{t(lang, "jump.btn.download")}</a>
  </div>
</section>
