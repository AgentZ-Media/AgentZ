---
/**
 * DOWNLOAD section - dedicated route (`/download`, `/en/download`).
 */
import { getLatestRelease, site } from "../../data/site";
import { t, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const release = await getLatestRelease();
---

<section class="v2-tab-content is-active" data-content="download" data-section-title={t(lang, "tab.download.long.mac")}>
  <h1 class="v2-block v2-action v2-scene">{t(lang, "dl.caption")}</h1>

  <div class="v2-block v2-action mac-only">{t(lang, "dl.action1.mac")}</div>
  <div class="v2-block v2-action win-only">{t(lang, "dl.action1.win")}</div>

  <div class="v2-download">
    <div class="v2-download-meta">
      <span class="v2-download-eyebrow">
        v{release.version} · <span class="mac-only">{t(lang, "dl.eyebrow.os.mac")}</span><span class="win-only">{t(lang, "dl.eyebrow.os.win")}</span>
      </span>
      <h2 class="v2-download-h">{t(lang, "dl.h")}</h2>
      <p class="v2-download-sub mac-only">{t(lang, "dl.sub.mac")}</p>
      <p class="v2-download-sub win-only">{t(lang, "dl.sub.win")}</p>
    </div>
    <div class="v2-download-cta">
      <a
        class="v2-btn v2-btn-primary v2-btn-lg js-platform-cta"
        href={release.dmgUrl}
        data-href-mac={release.dmgUrl}
        data-href-win={release.exeUrl}
        data-label-mac={t(lang, "dl.cta.dmg")}
        data-label-win={t(lang, "dl.cta.exe")}
      >
        <svg class="js-platform-icon-mac" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.05 13.31c-.02-2.53 2.06-3.74 2.16-3.8-1.18-1.72-3.02-1.96-3.67-1.99-1.56-.16-3.05.92-3.84.92-.81 0-2.02-.9-3.32-.87-1.71.03-3.29 1-4.17 2.52-1.78 3.09-.45 7.65 1.28 10.16.85 1.23 1.85 2.61 3.16 2.56 1.27-.05 1.75-.82 3.28-.82 1.52 0 1.96.82 3.3.79 1.36-.02 2.22-1.25 3.05-2.49.97-1.43 1.36-2.83 1.38-2.9-.03-.01-2.64-1.01-2.61-4.08zM14.71 5.49c.7-.85 1.18-2.03 1.04-3.21-1.01.04-2.24.67-2.97 1.51-.65.74-1.22 1.94-1.07 3.1 1.13.09 2.29-.57 3-1.4z"/>
        </svg>
        <svg class="js-platform-icon-win" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3 5.49 10.5 4.5v7.49H3zm0 13.02L10.5 19.5v-7.49H3zm8.5-13.65L21 3.5v8.49h-9.5zm0 14.28L21 20.5v-8.49h-9.5z"/>
        </svg>
        <span class="js-platform-label">{t(lang, "dl.cta.dmg")}</span>
      </a>
      <a class="v2-btn v2-btn-ghost-dark v2-btn-lg" href={site.github} target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2.01-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.04 0 0 .98-.31 3.2 1.18a11.1 11.1 0 0 1 2.91-.39c.99 0 1.98.13 2.91.39 2.22-1.5 3.2-1.18 3.2-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.13 0 .31.2.67.8.55C20.71 21.38 24 17.07 24 12 24 5.65 18.85.5 12.5.5h-.5z"/>
        </svg>
        {t(lang, "dl.cta.code")}
      </a>
    </div>
    <a class="v2-download-fallback" href={release.releasePageUrl} target="_blank" rel="noopener">
      {t(lang, "dl.fallback.label")}
    </a>
    <div class="v2-download-stats">
      <span><b>{release.version}</b> {t(lang, "dl.stat.version")}</span>
      <span class="v2-stat-sep">|</span>
      <span><b>0</b> {t(lang, "dl.stat.tracker")}</span>
      <span class="v2-stat-sep">|</span>
      <span><b>0</b> {t(lang, "dl.stat.accounts")}</span>
      <span class="v2-stat-sep">|</span>
      <span><b>0</b> {t(lang, "dl.stat.ai")}</span>
      <span class="v2-stat-sep">|</span>
      <span><b>1</b> <span class="mac-only">{t(lang, "dl.stat.dmg")}</span><span class="win-only">{t(lang, "dl.stat.exe")}</span></span>
    </div>
    <div class="v2-download-webhint">
      {t(lang, "dl.web.intro")}{" "}
      <a href={site.webAppUrl} target="_blank" rel="noopener">
        {t(lang, "dl.web.link")}
      </a>
      <span class="v2-download-webhint-sub">{t(lang, "dl.web.sub")}</span>
    </div>
  </div>

  <h2 class="v2-block v2-action v2-scene">{t(lang, "dl.firstRun")}</h2>

  <div class="v2-block v2-action mac-only">{t(lang, "dl.action2.mac")}</div>
  <div class="v2-block v2-action win-only">{t(lang, "dl.action2.win")}</div>

  <div class="v2-install v2-install-paper mac-only">
    <div class="v2-install-body">
      <div class="v2-install-code">
        <code>xattr -cr /Applications/ScriptZ.app</code>
        <button class="v2-install-copy" type="button" data-copy="xattr -cr /Applications/ScriptZ.app">
          {t(lang, "install.copy")}
        </button>
      </div>
      <p class="v2-install-why">
        <strong>{t(lang, "install.mac.whyShort.label")}</strong> {t(lang, "install.mac.whyShort.body")}
      </p>
    </div>
  </div>

  <div class="v2-install v2-install-paper win-only">
    <div class="v2-install-body">
      <ol class="v2-install-steps">
        <li>{t(lang, "install.win.step1")}</li>
        <li>{t(lang, "install.win.step2")}</li>
      </ol>
      <p class="v2-install-why">
        <strong>{t(lang, "install.win.whyShort.label")}</strong> {t(lang, "install.win.whyShort.body")}
      </p>
    </div>
  </div>

  <div class="v2-block v2-action">{t(lang, "dl.fadeOut")}</div>

  <div class="v2-end">
    <div class="v2-end-line"></div>
    <span class="v2-end-text">{t(lang, "dl.end")}</span>
    <div class="v2-end-line"></div>
  </div>
</section>
