---
/**
 * HOME section - dedicated content for `/` and `/en`. Instead of
 * repeating the Warum route, here's a short overview: screenshot
 * gallery, four feature teasers with links to the detail routes,
 * comparison hint and a closing download block.
 *
 * Caption as H2 because the page hero on this route already carries
 * an H1 - otherwise the page would have two H1s.
 */
import { routePath, t, type Lang } from "../../i18n";
import { getLatestRelease } from "../../data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const release = await getLatestRelease();
---

<section class="v2-tab-content is-active v2-home" data-content="home" data-section-title={t(lang, "tab.home.title")}>

  <!-- Screenshot gallery ------------------------------------------- -->
  <div class="v2-home-block">
    <h2 class="v2-home-h2">{t(lang, "home.gallery.h2")}</h2>
    <p class="v2-home-sub">{t(lang, "home.gallery.sub")}</p>
    <div class="v2-shot-wrap">
      <div class="v2-shot-tabs" role="tablist">
        <button class="v2-shot-tab is-active" type="button" data-shot="overview" role="tab" aria-selected="true">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>
          </svg>
          {t(lang, "shot.tab.overview")}
        </button>
        <button class="v2-shot-tab" type="button" data-shot="ideas" role="tab" aria-selected="false">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 18h6"/><path d="M10 22h4"/>
            <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V18h6v-1.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>
          </svg>
          {t(lang, "shot.tab.ideas")}
        </button>
        <button class="v2-shot-tab" type="button" data-shot="editor" role="tab" aria-selected="false">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>
          </svg>
          {t(lang, "shot.tab.editor")}
        </button>
      </div>
      <div class="v2-shot-frame">
        <img class="v2-shot is-active" src="/img/app/overview.png" alt={t(lang, "shot.alt.overview")} data-shot="overview" loading="lazy" />
        <img class="v2-shot" src="/img/app/ideas.png" alt={t(lang, "shot.alt.ideas")} data-shot="ideas" loading="lazy" />
        <img class="v2-shot" src="/img/app/editor.png" alt={t(lang, "shot.alt.editor")} data-shot="editor" loading="lazy" />
      </div>
    </div>
  </div>

  <!-- Four feature teasers ----------------------------------------- -->
  <div class="v2-home-block">
    <h2 class="v2-home-h2">{t(lang, "home.features.h2")}</h2>
    <div class="v2-home-grid">
      <a class="v2-home-card" href={routePath(lang, "quickmodus")}>
        <h3>{t(lang, "home.feature.quick.title")}</h3>
        <p>{t(lang, "home.feature.quick.body")}</p>
        <span class="v2-home-card-cta">{t(lang, "home.feature.quick.link")}</span>
      </a>
      <a class="v2-home-card" href={`${routePath(lang, "warum")}#length`}>
        <h3>{t(lang, "home.feature.length.title")}</h3>
        <p>{t(lang, "home.feature.length.body")}</p>
        <span class="v2-home-card-cta">{t(lang, "home.feature.length.link")}</span>
      </a>
      <a class="v2-home-card" href={routePath(lang, "ideen")}>
        <h3>{t(lang, "home.feature.pipeline.title")}</h3>
        <p>{t(lang, "home.feature.pipeline.body")}</p>
        <span class="v2-home-card-cta">{t(lang, "home.feature.pipeline.link")}</span>
      </a>
      <a class="v2-home-card" href={routePath(lang, "no-ai")}>
        <h3>{t(lang, "home.feature.noai.title")}</h3>
        <p>{t(lang, "home.feature.noai.body")}</p>
        <span class="v2-home-card-cta">{t(lang, "home.feature.noai.link")}</span>
      </a>
    </div>
  </div>

  <!-- Comparison teaser --------------------------------------------- -->
  <div class="v2-home-block v2-home-compare">
    <h2 class="v2-home-h2">{t(lang, "home.compare.h2")}</h2>
    <p class="v2-home-compare-body">{t(lang, "home.compare.body")}</p>
    <a class="v2-home-compare-cta" href={routePath(lang, "vergleich")}>
      {t(lang, "home.compare.cta")}
    </a>
  </div>

  <!-- Closing download block ---------------------------------------- -->
  <div class="v2-home-block v2-home-closing">
    <span class="v2-home-closing-eyebrow">{t(lang, "home.closing.eyebrow")}</span>
    <h2 class="v2-home-closing-h2">{t(lang, "home.closing.h2")}</h2>
    <p class="v2-home-closing-body">{t(lang, "home.closing.body")}</p>
    <div class="v2-home-closing-cta">
      <a
        class="v2-btn v2-btn-primary v2-btn-lg js-platform-cta"
        href={release.dmgUrl}
        data-href-mac={release.dmgUrl}
        data-href-win={release.exeUrl}
        data-label-mac={t(lang, "dl.cta.dmg")}
        data-label-win={t(lang, "dl.cta.exe")}
      >
        <svg class="js-platform-icon-mac" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.05 13.31c-.02-2.53 2.06-3.74 2.16-3.8-1.18-1.72-3.02-1.96-3.67-1.99-1.56-.16-3.05.92-3.84.92-.81 0-2.02-.9-3.32-.87-1.71.03-3.29 1-4.17 2.52-1.78 3.09-.45 7.65 1.28 10.16.85 1.23 1.85 2.61 3.16 2.56 1.27-.05 1.75-.82 3.28-.82 1.52 0 1.96.82 3.3.79 1.36-.02 2.22-1.25 3.05-2.49.97-1.43 1.36-2.83 1.38-2.9-.03-.01-2.64-1.01-2.61-4.08zM14.71 5.49c.7-.85 1.18-2.03 1.04-3.21-1.01.04-2.24.67-2.97 1.51-.65.74-1.22 1.94-1.07 3.1 1.13.09 2.29-.57 3-1.4z"/>
        </svg>
        <svg class="js-platform-icon-win" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3 5.49 10.5 4.5v7.49H3zm0 13.02L10.5 19.5v-7.49H3zm8.5-13.65L21 3.5v8.49h-9.5zm0 14.28L21 20.5v-8.49h-9.5z"/>
        </svg>
        <span class="js-platform-label">{t(lang, "dl.cta.dmg")}</span>
      </a>
      <a class="v2-btn v2-btn-ghost v2-btn-lg" href={routePath(lang, "download")}>
        {t(lang, "tab.download.short")}
      </a>
    </div>
    <div class="v2-hero-meta">
      <span><b>v{release.version}</b> · <span class="mac-only">{t(lang, "hero.meta.os.mac")}</span><span class="win-only">{t(lang, "hero.meta.os.win")}</span></span>
      <span class="v2-meta-sep">·</span>
      <span>{t(lang, "hero.meta.zero")}</span>
    </div>
  </div>
</section>
