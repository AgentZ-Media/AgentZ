---
/**
 * AppShell - the app showcase on the landing.
 *
 * Mirrors the "Werkbank" app shell: a dark sidebar on the left (app
 * mark, route links as real `<a>` elements, writing-counter echo in
 * the footer), a header bar on top of the main column (history
 * arrows, breadcrumb, stage chip, language toggle, download button)
 * and the white sheet in the middle. A floating runtime pill echoes
 * the app's length estimate.
 *
 * What is NOT in here: the hero (comes from PageHero above the
 * shell), the section markup per route (comes in via `<slot/>`).
 * That keeps each page small and able to carry its own title/meta.
 *
 * View transitions: the chrome is re-rendered on every route change
 * (no `transition:persist`), so labels follow the language. The
 * inline script is re-run from Base.astro after every swap.
 */
import { getLatestRelease, site } from "../data/site";
import { routePath, switchLangPath, t, type Lang, type RouteKey } from "../i18n";
import SiteFooter from "./SiteFooter.astro";
import "../styles/landing.css";

interface Props {
  lang: Lang;
  /** Which route does this page belong to? Determines the
   *  `is-active` class in the sidebar and the header-bar title. Blog
   *  pages pass `"blog"`, which has no sidebar entry - nothing is
   *  marked active then. */
  activeTab: RouteKey;
  /** Optional: overrides the header-bar title. Blog-post pages pass
   *  the post title here instead of a generic route label. */
  toolbarTitleOverride?: string;
  /** Optional: overrides the target URL of the language toggle. Used
   *  for blog posts, where the slug may or may not exist and the page
   *  itself must make that decision. */
  switchLangHrefOverride?: string;
}

const { lang, activeTab, toolbarTitleOverride, switchLangHrefOverride } = Astro.props;
const release = await getLatestRelease();

const otherLang: Lang = lang === "de" ? "en" : "de";
const currentRoutePath = routePath(lang, activeTab);
const switchHref = switchLangHrefOverride ?? switchLangPath(lang, otherLang, currentRoutePath);

// Header-bar title per route. The download route additionally depends
// on the platform; the inline script swaps it via data attributes.
const titleKeyMap: Record<RouteKey, Parameters<typeof t>[1]> = {
  home: "tab.home.long",
  warum: "tab.warum.long",
  quickmodus: "tab.quickmodus.long",
  "no-ai": "tab.noai.long",
  vergleich: "tab.compare.long",
  download: "tab.download.long.mac",
  ideen: "tab.ideas.title",
  blog: "blog.toolbar.title.index",
};
const toolbarTitle = toolbarTitleOverride ?? t(lang, titleKeyMap[activeTab]);
const isDownload = activeTab === "download" && !toolbarTitleOverride;

// Paths per route in the current language, computed once so the
// markup below stays readable.
const links = {
  home: routePath(lang, "home"),
  ideen: routePath(lang, "ideen"),
  warum: routePath(lang, "warum"),
  quickmodus: routePath(lang, "quickmodus"),
  "no-ai": routePath(lang, "no-ai"),
  vergleich: routePath(lang, "vergleich"),
  download: routePath(lang, "download"),
  blog: routePath(lang, "blog"),
};

// "Scripts" group in the sidebar: every content route reads like a
// script the visitor can open.
const scriptRoutes: { key: RouteKey; labelKey: Parameters<typeof t>[1] }[] = [
  { key: "warum", labelKey: "tab.warum.short" },
  { key: "quickmodus", labelKey: "tab.quickmodus.short" },
  { key: "no-ai", labelKey: "tab.noai.short" },
  { key: "vergleich", labelKey: "tab.compare.short" },
  { key: "download", labelKey: "tab.download.short" },
];

// Count of sample ideas on the ideas route (IdeenSection renders six).
const openIdeasCount = 6;

// Dot-matrix Z (6 x 5) - same geometry as the app mark. Row-major
// [col, row] pairs; `soft` dots render at reduced opacity.
const zDots: [number, number][] = [
  [0, 0], [1, 0], [2, 0], [3, 0], [4, 0],
  [3, 1], [4, 1],
  [2, 2], [3, 2],
  [1, 3], [2, 3],
  [0, 4], [1, 4],
  [0, 5], [1, 5], [2, 5], [3, 5], [4, 5],
];
const zSoft: [number, number][] = [[0, 1], [1, 1], [2, 1], [2, 4], [3, 4], [4, 4]];

// Pass JS-side strings down to the inline script.
const jsStrings = {
  copy: t(lang, "install.copy"),
  copied: t(lang, "install.copied"),
  copyManual: t(lang, "install.copyManual"),
  runLabel: t(lang, "runpill.label"),
  wordsUnit: t(lang, "side.counter.unit"),
  locale: lang === "de" ? "de-DE" : "en-US",
};
---

<div class="v2-shell" data-theme="light">

  <!-- SIDEBAR - echoes the app's sidebar: app mark, links, counter. -->
  <aside class="v2-side" aria-label={t(lang, "side.aria")}>
    <div class="v2-traffic" aria-hidden="true">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
    </div>

    <a class="v2-side-app" href={links.home} aria-label={t(lang, "tab.home.aria")}>
      <span class="v2-side-mark" aria-hidden="true">
        <svg viewBox="0 0 50 60" width="12" height="15">
          {zDots.map(([c, r]) => <circle cx={5 + c * 10} cy={5 + r * 10} r="3.1" />)}
          {zSoft.map(([c, r]) => <circle cx={5 + c * 10} cy={5 + r * 10} r="3.1" opacity="0.5" />)}
        </svg>
      </span>
      <span class="v2-side-name">ScriptZ</span>
    </a>

    <nav class="v2-side-nav">
      <a class:list={["v2-side-item", activeTab === "home" && "is-active"]} href={links.home} aria-current={activeTab === "home" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/>
        </svg>
        <span class="v2-side-lbl">{t(lang, "tab.home.title")}</span>
      </a>
      <a class:list={["v2-side-item", activeTab === "ideen" && "is-active"]} href={links.ideen} aria-current={activeTab === "ideen" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 18h6"/><path d="M10 22h4"/>
          <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V18h6v-1.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>
        </svg>
        <span class="v2-side-lbl">{t(lang, "tab.ideas.title")}</span>
        <span class="v2-side-n">{openIdeasCount}</span>
      </a>

      <div class="v2-side-h">{t(lang, "side.section.scripts")}</div>
      {scriptRoutes.map(({ key, labelKey }) => (
        <a class:list={["v2-side-item", activeTab === key && "is-active"]} href={links[key]} aria-current={activeTab === key ? "page" : undefined}>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>
          </svg>
          <span class="v2-side-lbl">{t(lang, labelKey)}</span>
        </a>
      ))}
    </nav>

    <!-- Writing-counter echo: word count of the current page. -->
    <div class="v2-side-foot" title={t(lang, "side.counter.title")}>
      <b class="v2-side-count" id="side-count">&nbsp;</b>
      <span class="v2-side-count-sub">{t(lang, "side.counter.sub")}</span>
    </div>
  </aside>

  <div class="v2-main">
    <!-- HEADER BAR - re-rendered on every route change. -->
    <div class="v2-chrome">
      <header class="v2-bar">
        <div class="v2-hist">
          <a class="v2-hist-btn" href={links.home} aria-label={t(lang, "toolbar.back.aria")}>
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </a>
          <span class="v2-hist-btn is-off" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </div>

        <div class="v2-crumb">
          <span class="v2-crumb-root">ScriptZ</span>
          <span class="v2-crumb-sep" aria-hidden="true">/</span>
          <b
            id="toolbar-title"
            data-title-mac={isDownload ? t(lang, "tab.download.long.mac") : undefined}
            data-title-win={isDownload ? t(lang, "tab.download.long.win") : undefined}
          >{toolbarTitle}</b>
        </div>

        <span class="v2-bar-saved">{t(lang, "status.saved")}</span>

        <span class="v2-stage-chip" title={t(lang, "toolbar.stage.title")}>
          <svg viewBox="0 0 14 14" width="12" height="12" aria-hidden="true">
            <circle cx="7" cy="7" r="6" fill="currentColor"/>
            <path d="M4.6 7.2l1.7 1.7 3.2-3.4" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {t(lang, "toolbar.stage")}
        </span>

        <div class="v2-lang" role="group" aria-label={t(lang, "lang.toggle.aria")}>
          {lang === "de" ? (
            <>
              <span class="v2-lang-pill is-active" aria-current="true">{t(lang, "lang.toggle.de")}</span>
              <a class="v2-lang-pill" href={switchHref} hreflang="en" data-lang-set="en">{t(lang, "lang.toggle.en")}</a>
            </>
          ) : (
            <>
              <a class="v2-lang-pill" href={switchHref} hreflang="de" data-lang-set="de">{t(lang, "lang.toggle.de")}</a>
              <span class="v2-lang-pill is-active" aria-current="true">{t(lang, "lang.toggle.en")}</span>
            </>
          )}
        </div>

        <a class="v2-status-pill" href={site.github} target="_blank" rel="noopener">
          <span class="v2-dot v2-dot-on"></span>
          {t(lang, "status.opensource")}
        </a>

        <a
          class="v2-toolbar-btn js-platform-cta"
          href={release.dmgUrl}
          data-href-mac={release.dmgUrl}
          data-href-win={release.exeUrl}
        >
          <svg class="js-platform-icon-mac" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.05 13.31c-.02-2.53 2.06-3.74 2.16-3.8-1.18-1.72-3.02-1.96-3.67-1.99-1.56-.16-3.05.92-3.84.92-.81 0-2.02-.9-3.32-.87-1.71.03-3.29 1-4.17 2.52-1.78 3.09-.45 7.65 1.28 10.16.85 1.23 1.85 2.61 3.16 2.56 1.27-.05 1.75-.82 3.28-.82 1.52 0 1.96.82 3.3.79 1.36-.02 2.22-1.25 3.05-2.49.97-1.43 1.36-2.83 1.38-2.9-.03-.01-2.64-1.01-2.61-4.08zM14.71 5.49c.7-.85 1.18-2.03 1.04-3.21-1.01.04-2.24.67-2.97 1.51-.65.74-1.22 1.94-1.07 3.1 1.13.09 2.29-.57 3-1.4z"/>
          </svg>
          <svg class="js-platform-icon-win" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3 5.49 10.5 4.5v7.49H3zm0 13.02L10.5 19.5v-7.49H3zm8.5-13.65L21 3.5v8.49h-9.5zm0 14.28L21 20.5v-8.49h-9.5z"/>
          </svg>
          {t(lang, "toolbar.download")}
        </a>
      </header>
    </div>

    <!-- PAPER (section content + footer) - swaps per route. -->
    <main class="v2-paper" id="paper">
      <slot />

      <!-- Footer - one component for all shells (see SiteFooter.astro) -->
      <SiteFooter lang={lang} />
    </main>
  </div>

  <!-- RUNTIME PILL - echoes the app's length estimate: how long the
       current page would take to say out loud, with scroll progress
       as the playhead. Re-renders per route. -->
  <div
    class="v2-runpill"
    id="runpill"
    data-label={jsStrings.runLabel}
    title={t(lang, "runpill.title")}
  >
    <span class="v2-runpill-ring">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" stroke-opacity="0.22"/>
        <circle
          class="v2-runpill-progress"
          cx="12" cy="12" r="9"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-dasharray="56.5487"
          stroke-dashoffset="56.5487"
          transform="rotate(-90 12 12)"
        />
      </svg>
    </span>
    <span class="v2-runpill-txt">{jsStrings.runLabel}</span>
  </div>
</div><!-- /v2-shell -->

<!-- Platform CTA update + page counters + copy button + language
     toggle persistence + screenshot gallery. Runs on first load and
     is re-triggered in Base.astro after every ClientRouter swap
     (astro:page-load). Hence `is:inline` without `data-astro-rerun`. -->
<script is:inline define:vars={{ jsStrings }}>
  // Global init function so Base.astro can call it again after
  // astro:page-load. Uses fixed symbols on the window object.
  window.__scriptzShellInit = function () {
    // ===== Platform CTA update ====================================
    var platform = document.documentElement.getAttribute('data-platform') || 'macos';
    var isWin = platform === 'windows';

    document.querySelectorAll('.js-platform-cta').forEach(function (el) {
      var hrefMac = el.getAttribute('data-href-mac');
      var hrefWin = el.getAttribute('data-href-win');
      var labelMac = el.getAttribute('data-label-mac');
      var labelWin = el.getAttribute('data-label-win');
      if (isWin && hrefWin) el.setAttribute('href', hrefWin);
      else if (hrefMac) el.setAttribute('href', hrefMac);
      var labelEl = el.querySelector('.js-platform-label');
      if (labelEl) labelEl.textContent = (isWin ? labelWin : labelMac) || labelEl.textContent;
    });

    // Header-bar title on the download route follows the platform.
    var titleEl = document.getElementById('toolbar-title');
    if (titleEl) {
      var tMac = titleEl.getAttribute('data-title-mac');
      var tWin = titleEl.getAttribute('data-title-win');
      var next = isWin ? tWin : tMac;
      if (next) titleEl.textContent = next;
    }

    // ===== Screenshot gallery =====================================
    var shotTabs = document.querySelectorAll('.v2-shot-tab');
    var shots = document.querySelectorAll('.v2-shot');
    shotTabs.forEach(function (tab) {
      // Idempotent: remove the old listener, register a new one
      if (tab.__handler) tab.removeEventListener('click', tab.__handler);
      var handler = function () {
        var id = tab.getAttribute('data-shot');
        shotTabs.forEach(function (x) {
          var on = x === tab;
          x.classList.toggle('is-active', on);
          x.setAttribute('aria-selected', String(on));
        });
        shots.forEach(function (s) {
          s.classList.toggle('is-active', s.getAttribute('data-shot') === id);
        });
      };
      tab.__handler = handler;
      tab.addEventListener('click', handler);
    });

    // ===== Copy button in the install hint ========================
    document.querySelectorAll('.v2-install-copy').forEach(function (btn) {
      if (btn.__handler) btn.removeEventListener('click', btn.__handler);
      var handler = async function () {
        var cmd = btn.getAttribute('data-copy') || '';
        try {
          await navigator.clipboard.writeText(cmd);
          btn.textContent = jsStrings.copied;
          btn.classList.add('is-done');
          setTimeout(function () {
            btn.textContent = jsStrings.copy;
            btn.classList.remove('is-done');
          }, 1600);
        } catch (e) {
          btn.textContent = jsStrings.copyManual;
          setTimeout(function () { btn.textContent = jsStrings.copy; }, 2000);
        }
      };
      btn.__handler = handler;
      btn.addEventListener('click', handler);
    });

    // ===== Page counters: words (sidebar) + runtime (pill) ========
    // Same estimate the app uses for spoken length: 210 words per
    // minute (the app's default speaking rate).
    var WPM = 210;
    var RING_CIRC = 56.5487;
    var paper = document.getElementById('paper');
    var contentEl = paper ? paper.querySelector('.v2-tab-content, .blog-post, .blog-index') : null;
    var text = contentEl ? contentEl.textContent.trim() : '';
    var words = text ? text.split(/\s+/).length : 0;

    var countEl = document.getElementById('side-count');
    if (countEl) {
      countEl.textContent = words > 0
        ? words.toLocaleString(jsStrings.locale) + ' ' + jsStrings.wordsUnit
        : '';
    }

    var fmt = function (sec) {
      var s = Math.max(0, Math.round(sec));
      var m = Math.floor(s / 60);
      var r = s % 60;
      return m + ':' + (r < 10 ? '0' : '') + r;
    };

    var pillTxt = document.querySelector('.v2-runpill-txt');
    var pillRing = document.querySelector('.v2-runpill-progress');
    if (window.__runpillScrollHandler) {
      window.removeEventListener('scroll', window.__runpillScrollHandler);
    }
    if (pillTxt) {
      var totalSec = Math.round((words / WPM) * 60);
      var updateProgress = function () {
        var top = window.scrollY;
        var max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
        var ratio = Math.min(Math.max(top / max, 0), 1);
        if (pillRing) {
          pillRing.setAttribute('stroke-dashoffset', String(RING_CIRC * (1 - ratio)));
        }
        if (totalSec === 0) {
          pillTxt.textContent = jsStrings.runLabel;
          return;
        }
        pillTxt.textContent = jsStrings.runLabel + ' ' + fmt(ratio * totalSec) + ' / ' + fmt(totalSec);
      };
      window.__runpillScrollHandler = updateProgress;
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
    }

    // ===== Language toggle: persist selection =====================
    document.querySelectorAll('[data-lang-set]').forEach(function (el) {
      if (el.__handler) el.removeEventListener('click', el.__handler);
      var handler = function () {
        var target = el.getAttribute('data-lang-set');
        if (target) {
          try { localStorage.setItem('scriptz-lang', target); } catch (_) { /* private mode */ }
        }
      };
      el.__handler = handler;
      el.addEventListener('click', handler);
    });
  };

  // First call on classic page load. On ClientRouter navigation,
  // Base.astro re-triggers this function via astro:page-load.
  window.__scriptzShellInit();
</script>
