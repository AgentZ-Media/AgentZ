---
/**
 * LegalShell - the editor look for Impressum and Datenschutz.
 *
 * Mirrors the landing layout: small hero on top, below that a
 * single app header bar (history arrow, breadcrumb with the two
 * legal pages, "Zur App" button - no tabs, like
 * the app), then a paper sheet with the editor's block classes.
 * Content comes in via <slot/> and is formatted in v2-block classes
 * (`v2-caption` for section headings, `v2-action` for paragraphs).
 * The heading classes are page styling here, not editor block types.
 *
 * Styling and markup are deliberately duplicated with index.astro
 * instead of a shared stylesheet - the legal pages rarely change,
 * and Astro scoping keeps the classes cleanly separated from the
 * index classes without requiring global CSS imports.
 */
import { site } from "../data/site";
import SiteFooter from "./SiteFooter.astro";

interface Props {
  /** Which legal page is marked active in the breadcrumb. */
  activeTab: "impressum" | "datenschutz";
  /** Toolbar title and content of the hero H1. */
  title: string;
  /** Short subtitle below the title in the hero. */
  subtitle: string;
}

const { activeTab, title, subtitle } = Astro.props;
---

<div class="v2-hero v2-hero-legal">
  <div class="v2-hero-inner">
    <span class="v2-eyebrow">RECHTLICHES</span>
    <h1 class="v2-h1 v2-h1-legal">{title}</h1>
    <p class="v2-lead">{subtitle}</p>
  </div>
</div>

<div class="v2-shell" data-theme="light">
  <div class="v2-chrome">

    <header class="v2-titlebar">
      <div class="v2-traffic" aria-hidden="true">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
      </div>

      <a class="v2-hist-btn" href="/" aria-label="Zurück zur Startseite">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </a>

      <nav class="v2-crumb" aria-label="Rechtliches">
        <span class="v2-crumb-root">ScriptZ</span>
        <span class="v2-crumb-sep" aria-hidden="true">/</span>
        <a
          class:list={["v2-crumb-link", activeTab === "impressum" && "is-active"]}
          href="/impressum"
          aria-current={activeTab === "impressum" ? "page" : undefined}
        >Impressum</a>
        <a
          class:list={["v2-crumb-link", activeTab === "datenschutz" && "is-active"]}
          href="/datenschutz"
          aria-current={activeTab === "datenschutz" ? "page" : undefined}
        >Datenschutz</a>
      </nav>

      <div class="v2-status">
        <a class="v2-status-pill" href={site.github} target="_blank" rel="noopener">
          <span class="v2-dot v2-dot-on"></span>
          Open Source
        </a>
        <a class="v2-toolbar-btn" href="/">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          Zur App
        </a>
      </div>
    </header>

  </div>

  <main class="v2-paper">
    <slot />

    <!-- Footer - shared with AppShell. Legal stays DE for legal reasons. -->
    <SiteFooter lang="de" />
  </main>
</div>

<style>
  /* === Hero (more compact than on the home page) ============= */
  .v2-hero {
    padding: 56px 24px 36px;
    text-align: center;
    border-bottom: 1px dashed rgba(28,24,20,0.18);
  }
  .v2-hero-inner { max-width: 720px; margin: 0 auto; }
  .v2-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #5b554c;
    margin-bottom: 18px;
  }
  .v2-eyebrow::before {
    content: "";
    display: inline-block;
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  .v2-h1-legal {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #1c1814;
    margin: 0;
  }
  .v2-lead {
    margin: 18px auto 0;
    max-width: 56ch;
    font-size: 15px;
    line-height: 1.6;
    color: #5b554c;
  }

  /* === Shell container ===================================== */
  .v2-shell {
    --v2-bg: #f5f3ee;
    --v2-paper: #ffffff;
    --v2-ink: #1c1814;
    --v2-ink-muted: rgba(28,24,20,0.65);
    --v2-ink-faint: rgba(28,24,20,0.45);
    --v2-border: rgba(28,24,20,0.10);
    --v2-border-strong: rgba(28,24,20,0.18);
    --v2-hover: rgba(28,24,20,0.05);
    --v2-paper-w: 820px;
    background: var(--v2-bg);
    color: var(--v2-ink);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.55;
    padding-bottom: 24px;
    /* Like an app window - see rationale on the home page. */
    max-width: 1600px;
    margin: 0 auto;
    border-radius: 12px;
    box-shadow:
      0 1px 2px rgba(28, 24, 20, 0.04),
      0 24px 60px rgba(28, 24, 20, 0.10),
      0 0 0 1px rgba(28, 24, 20, 0.06);
  }

  /* === Chrome ============================================== */
  .v2-chrome {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--v2-bg);
  }

  .v2-titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--v2-border);
    /* Mirrors the shell radius - the sticky titlebar must have the
       same upper corners, otherwise it juts past the rounded shell
       corners. */
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
  }
  .v2-traffic { display: flex; gap: 6px; padding-right: 6px; }
  .v2-traffic .dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    display: inline-block;
    box-shadow: 0 0 0 0.5px rgba(0,0,0,0.15);
  }
  .v2-traffic .dot-red    { background: #ff5f57; }
  .v2-traffic .dot-yellow { background: #febc2e; }
  .v2-traffic .dot-green  { background: #28c840; }

  .v2-hist-btn {
    flex: none;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 6px;
    color: var(--v2-ink-muted);
    text-decoration: none;
  }
  .v2-hist-btn:hover { background: var(--v2-hover); color: var(--v2-ink); }
  .v2-crumb {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
  }
  .v2-crumb-root, .v2-crumb-sep { color: var(--v2-ink-faint); }
  .v2-crumb-link {
    padding: 3px 8px;
    border-radius: 6px;
    color: var(--v2-ink-muted);
    text-decoration: none;
  }
  .v2-crumb-link:hover { background: var(--v2-hover); color: var(--v2-ink); }
  .v2-crumb-link.is-active { color: var(--v2-ink); font-weight: 700; }

  .v2-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }
  .v2-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--v2-paper);
    border: 1px solid var(--v2-border);
    color: var(--v2-ink-muted);
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
  }
  .v2-status-pill:hover { border-color: var(--v2-border-strong); color: var(--v2-ink); }
  .v2-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #4f9a6c;
    display: inline-block;
  }

  .v2-toolbar-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border-radius: 6px;
    background: var(--v2-ink);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: background 120ms ease;
  }
  .v2-toolbar-btn:hover { background: #0f0d0a; }

  /* === Paper =============================================== */
  .v2-paper {
    width: var(--v2-paper-w);
    max-width: calc(100vw - 48px);
    margin: 24px auto 0;
    background: var(--v2-paper);
    padding: 40px 64px 32px;
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.03),
      0 8px 24px rgba(0, 0, 0, 0.06),
      0 0 0 1px rgba(0, 0, 0, 0.04);
    border-radius: 4px;
    font-feature-settings: "liga" 1, "calt" 1;
    min-height: 50vh;
  }

  /* === Block styling (same as on the home page) ====== */
  :global(.v2-block) {
    position: relative;
    margin: 0;
    padding: 0;
    white-space: normal;
    word-break: break-word;
  }
  :global(.v2-block + .v2-block) { margin-top: 4px; }
  :global(.v2-block.v2-action + .v2-block.v2-action) { margin-top: 14px; }
  :global(.v2-block.v2-caption + *) { margin-top: 14px; }
  :global(* + .v2-block.v2-caption) { margin-top: 32px; }

  :global(.v2-action) { text-align: left; }
  :global(.v2-caption) {
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 14px;
  }
  :global(.v2-camera) {
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 700;
    font-size: 13px;
    color: rgba(28,24,20,0.65);
  }
  :global(.v2-sfx) {
    text-align: left;
    font-weight: 500;
    letter-spacing: 0.02em;
    font-size: 13px;
    color: rgba(28,24,20,0.65);
    text-transform: uppercase;
    margin-top: 14px;
  }

  /* Lists in the paper - indented like ACTION sub-items */
  :global(.v2-paper ul.v2-list) {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
  }
  :global(.v2-paper ul.v2-list li) {
    position: relative;
    padding: 4px 0 4px 22px;
    color: rgba(28,24,20,0.78);
  }
  :global(.v2-paper ul.v2-list li::before) {
    content: "—";
    position: absolute;
    left: 0;
    top: 4px;
    color: rgba(28,24,20,0.45);
    font-weight: 700;
  }

  /* Address block - styled like an ACTION entry with uppercase label */
  :global(.v2-paper .v2-address) {
    margin: 4px 0 0;
    line-height: 1.55;
  }
  :global(.v2-paper a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(28,24,20,0.32);
    text-underline-offset: 2px;
    transition: text-decoration-color 120ms ease;
  }
  :global(.v2-paper a:hover) {
    text-decoration-color: rgba(28,24,20,0.85);
  }
  :global(.v2-paper code) {
    background: rgba(28,24,20,0.06);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 13px;
    font-family: inherit;
  }
  :global(.v2-paper em) { font-style: italic; }

  /* === Footer styling lives in SiteFooter.astro (scoped) ===== */

  /* === Responsive ========================================== */
  @media (max-width: 880px) {
    .v2-hero { padding: 36px 18px 24px; }
    .v2-paper { padding: 28px 24px 32px; margin: 16px auto 0; }
    .v2-crumb-root, .v2-crumb-sep { display: none; }
  }
  /* On mobile completely without app chrome - navigation comes from
     MobileNav.astro (sticky bar on top + drawer). */
  @media (max-width: 768px) {
    .v2-shell {
      max-width: 100%;
      border-radius: 0;
      box-shadow: none;
      padding-bottom: 0;
    }
    .v2-chrome { display: none; }
    .v2-paper {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      border-radius: 0;
      padding: 20px 18px 28px;
      box-shadow: none;
    }
  }
  @media (max-width: 560px) {
    .v2-shell { font-size: 13px; }
    .v2-paper { padding: 20px 18px 24px; }
  }
</style>
