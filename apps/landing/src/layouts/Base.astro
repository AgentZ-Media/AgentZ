---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getLatestRelease, site } from "../data/site";
import { routeKeyFromPath, switchLangPath, t, type Lang } from "../i18n";
import MobileNav from "../components/MobileNav.astro";

interface Props {
  title?: string;
  description?: string;
  /** Prepended to the site name in <title>. */
  pageTitle?: string;
  /**
   * Page language. Default `de`. Legal pages (Impressum,
   * Datenschutz) stay on `de` because German law requires it -
   * the auto-detect redirect ignores those paths.
   */
  lang?: Lang;
}

const {
  title,
  description,
  pageTitle,
  lang = "de",
} = Astro.props;

const finalDescription = description ?? site.description;
const fullTitle =
  title ?? (pageTitle ? `${pageTitle} - ${site.name}` : `${site.name} - ${t(lang, "meta.title")}`);
const ogImage = `${site.url}/img/icon-large.png`;
const ogLocale = t(lang, "meta.ogLocale");
const htmlLang = lang === "en" ? "en" : "de";

// Canonical and hreflang.
// `build.format: "file"` appends `.html` to paths - so
// `Astro.url.pathname` may arrive as `/impressum.html` instead of
// `/impressum`. We normalize once here so all comparisons (isLegal,
// isHome, hreflang) see the same scheme.
const rawPath = Astro.url.pathname;
const currentPath = (() => {
  let p = rawPath.replace(/\.html$/, "").replace(/\/$/, "");
  // `/index` -> `/`, `/en/index` -> `/en` etc.
  p = p.replace(/\/index$/, "");
  return p || "/";
})();
const isLegal = currentPath === "/impressum" || currentPath === "/datenschutz";
const isHome = currentPath === "/" || currentPath === "/en";

// hreflang paths per language: tab routes have language-specific
// slugs (`/quickmodus` <-> `/en/quick-mode`), legal pages exist only
// in DE. `switchLangPath` covers both cases.
const dePath = lang === "de" ? currentPath : switchLangPath(lang, "de", currentPath);
const enPath = isLegal ? null : (lang === "en" ? currentPath : switchLangPath(lang, "en", currentPath));
const deHref = new URL(dePath, site.url).toString();
const enHref = enPath ? new URL(enPath, site.url).toString() : null;
const canonical = lang === "en" ? (enHref ?? deHref) : deHref;

// Structured data (JSON-LD): helps search engines recognize ScriptZ
// as software and AgentZ Media as publisher. `Organization` sits on
// every page, `SoftwareApplication` only on the home routes
// (`/`, `/en`).
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "AgentZ Media",
  url: site.url,
  email: site.contactEmail,
  sameAs: [site.github],
  logo: `${site.url}/img/icon-large.png`,
};

let softwareLd: Record<string, unknown> | null = null;
if (isHome) {
  const release = await getLatestRelease();
  softwareLd = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: site.name,
    url: canonical,
    description: finalDescription,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "macOS 13+, Windows 10+",
    softwareVersion: release.version,
    downloadUrl: release.releasePageUrl,
    image: ogImage,
    inLanguage: lang === "en" ? "en" : "de",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "EUR",
    },
    publisher: {
      "@type": "Organization",
      name: "AgentZ Media",
      url: site.url,
    },
  };
}

// Should this page use the ClientRouter? Yes for all tab routes
// (warum/quickmodus/no-ai/vergleich/download/ideen). No for legal -
// there's no "tab-switch" UX there; clicking Impressum from the
// footer is a real page navigation, a rebuild is fine.
const tabRouteKey = routeKeyFromPath(currentPath);
const isTabRoute = tabRouteKey !== null;

// Active route for the MobileNav. Tab routes deliver their key,
// legal pages have their own markers, all other paths stay
// unmarked (e.g. 404, future sub-pages).
const mobileNavActive: Parameters<typeof MobileNav>[0]["activeRoute"] =
  tabRouteKey ??
  (currentPath === "/impressum" ? "impressum"
    : currentPath === "/datenschutz" ? "datenschutz"
    : null);
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={finalDescription} />

    <link rel="icon" type="image/png" href="/img/icon.png" />
    <link rel="apple-touch-icon" href="/img/icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- hreflang: tells Google the other language variant.
         `x-default` points to the German variant because that's
         the site's default language. -->
    <link rel="alternate" hreflang="de" href={deHref} />
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    <link rel="alternate" hreflang="x-default" href={deHref} />

    <link rel="preload" href="/fonts/iAWriterQuattroS-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/iAWriterQuattroS-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content="index, follow" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {softwareLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareLd)} />}

    <!-- View transitions / ClientRouter: turns route changes into
         a soft cross-fade instead of a full reload. The chrome is
         re-rendered per route (no `transition:persist`), so labels
         follow the language. -->
    <ClientRouter fallback="swap" />

    <!-- Platform auto-detect: runs synchronously before the first
         paint and sets `<html data-platform="windows|macos|linux">`.
         CSS rules in landing.css (`.mac-only` / `.win-only`) show
         the matching platform variant. The markup default is macOS,
         so we only need to switch on Windows/Linux - the Mac path
         needs no attribute.
         Prefers `navigator.userAgentData.platform` (Client Hints,
         modern, explicit string), falls back to a
         `navigator.userAgent` regex (covers older Firefox + Safari).
         When unsure we stay on macOS. -->
    <script is:inline>
      (function () {
        try {
          var p = "";
          var uad = navigator.userAgentData;
          if (uad && uad.platform) {
            p = String(uad.platform).toLowerCase();
          } else {
            var ua = (navigator.userAgent || "").toLowerCase();
            if (ua.indexOf("win") !== -1) p = "windows";
            else if (ua.indexOf("mac") !== -1 || ua.indexOf("iphone") !== -1 || ua.indexOf("ipad") !== -1) p = "macos";
            else if (ua.indexOf("linux") !== -1 || ua.indexOf("android") !== -1) p = "linux";
          }
          var resolved = "macos";
          if (p.indexOf("win") === 0 || p === "windows") resolved = "windows";
          else if (p.indexOf("mac") === 0 || p === "macos" || p === "ios") resolved = "macos";
          else if (p.indexOf("linux") === 0 || p === "android") resolved = "linux";
          document.documentElement.setAttribute("data-platform", resolved);
        } catch (_) {
          document.documentElement.setAttribute("data-platform", "macos");
        }
      })();
    </script>

    <!-- Language auto-detect: runs before the reveal script so the
         redirect can happen before the first paint.
         Rules:
           1. If the user already made a choice
              (localStorage["scriptz-lang"]), never auto-redirect.
           2. On legal pages never redirect - they only exist in DE.
           3. Otherwise: look at navigator.language. If it starts
              with "de", the German page fits, no redirect needed.
              Otherwise - if we're on "/" - redirect once to "/en".
           4. Never redirect from /en back to /, even if the browser
              language is "de" - the user might have shared the link
              deliberately. Only the explicit toggle choice decides
              permanently. -->
    <script is:inline>
      (function() {
        try {
          var path = location.pathname;
          if (path === "/impressum" || path === "/datenschutz") return;
          if (localStorage.getItem("scriptz-lang")) return;
          var browserLang = (navigator.language || "de").slice(0, 2).toLowerCase();
          var onEn = path === "/en" || path.indexOf("/en/") === 0;
          if (browserLang !== "de" && !onEn) {
            location.replace("/en");
          }
        } catch (_) { /* private mode etc. */ }
      })();
    </script>
  </head>
  <body data-lang={lang} data-is-tab-route={isTabRoute ? "true" : "false"}>
    <!-- Mobile navigation. Visible only at <= 768 px (CSS toggle
         in the component). Sits BEFORE the slot so it stays on top
         on every page - before PageHero, before AppShell, before
         the legal hero. -->
    <MobileNav lang={lang} activeRoute={mobileNavActive} currentPath={currentPath} />

    <slot />

    <!-- ClientRouter after-swap handler:
         1. Re-run the shell init (re-binds copy button, page
            counters, platform CTA, screenshot gallery). Function comes from
            AppShell.astro and lives globally at
            `window.__scriptzShellInit`.
         2. Scroll to the top so every route switch returns the
            user to the page start (incl. hero), like a classic page
            load - or to the `#hash` target if the link carries one.
         3. Restart the reveal-on-scroll observer - the `.reveal`
            targets are fresh in the DOM. -->
    <script is:inline>
      (function () {
        var scrollToPageTop = function () {
          // Links with a hash (e.g. the home teaser to `#length`) land
          // on their target instead of the page top.
          var id = location.hash ? decodeURIComponent(location.hash.slice(1)) : "";
          var target = id ? document.getElementById(id) : null;
          if (target) {
            target.scrollIntoView({ behavior: "instant", block: "start" });
            return;
          }
          window.scrollTo({ top: 0, behavior: "instant" });
        };

        var reveal = function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              entries[i].target.classList.add("is-visible");
            }
          }
        };
        var observer = null;
        var initReveal = function () {
          if (observer) observer.disconnect();
          observer = new IntersectionObserver(reveal, {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          });
          document.querySelectorAll(".reveal").forEach(function (el) { observer.observe(el); });
        };

        // First setup
        initReveal();

        document.addEventListener("astro:after-swap", function () {
          if (typeof window.__scriptzShellInit === "function") {
            window.__scriptzShellInit();
          }
          if (typeof window.__scriptzMobileNavInit === "function") {
            window.__scriptzMobileNavInit();
          }
          scrollToPageTop();
          initReveal();
        });
      })();
    </script>
  </body>
</html>
