---
import "@agentz/design/tokens.css";
import "@agentz/design/fonts.css";
import "@agentz/design/components.css";
import "../styles/fonts.css";
import "../styles/palette.css";
import "../styles/site.css";
import suiteIcon from "@agentz/design/assets/suite-app-icon.svg?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { catalogs, type Language, type PagePaths } from "../i18n";

interface Props {
  lang?: Language;
  title?: string;
  description?: string;
  /** Paths of this page in every language; enables the language switch. */
  paths?: PagePaths;
  noindex?: boolean;
  /** Full-screen page without header and footer (app sign-in). */
  bare?: boolean;
  /** The page drives the dot field itself (home page) instead of the plain grid. */
  field?: "plain" | "page";
  /** Link preview (Open Graph), see scripts/build-og.mjs; the suite image by default. */
  image?: { path: string; alt: string };
  /** Structured data (schema.org) for search engines. */
  schema?: Record<string, unknown>;
}
const { lang = "de", title, paths, noindex = false, bare = false, field = "plain", schema } = Astro.props;
const t = catalogs[lang];
const description = Astro.props.description ?? t.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title ? `${title} | AgentZ Suite` : t.meta.title;
const image = Astro.props.image ?? { path: `/og/suite-${lang}.jpg`, alt: t.meta.suiteImage };
const imageUrl = new URL(image.path, Astro.site);
const locales = { de: "de_DE", en: "en_US" } as const;
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={suiteIcon} />
    <link rel="apple-touch-icon" href="/img/suite.png" />
    {noindex && <meta name="robots" content="noindex" />}
    {paths && <><link rel="alternate" hreflang="de" href={new URL(paths.de, Astro.site)} /><link rel="alternate" hreflang="en" href={new URL(paths.en, Astro.site)} /><link rel="alternate" hreflang="x-default" href={new URL(paths.de, Astro.site)} /></>}
    <meta property="og:site_name" content="AgentZ Suite" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locales[lang]} />
    {paths && <meta property="og:locale:alternate" content={locales[lang === "de" ? "en" : "de"]} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify({ "@context": "https://schema.org", ...schema })} />}
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body class:list={[bare && "is-bare"]}>
    <canvas class="dot-field" data-field={field} aria-hidden="true"></canvas>
    {bare ? <main id="content"><slot /></main> : <>
      <a class="skip-link btn" href="#content">{t.skip}</a>
      <Header lang={lang} paths={paths} />
      <main id="content"><slot /></main>
      <Footer lang={lang} paths={paths} />
    </>}
    <script>import "../scripts/site";</script>
  </body>
</html>
