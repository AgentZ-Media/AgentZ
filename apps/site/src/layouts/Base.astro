---
import "@agentz/design/tokens.css";
import "@agentz/design/fonts.css";
import "@agentz/design/components.css";
import "../styles/fonts.css";
import "../styles/palette.css";
import "../styles/site.css";
import suiteIcon from "@agentz/design/assets/suite-app-icon.svg?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { catalogs, type Language } from "../i18n";

interface Props {
  lang?: Language;
  title?: string;
  description?: string;
  home?: boolean;
}
const { lang = "de", title = "AgentZ Suite", home = false } = Astro.props;
const t = catalogs[lang];
const description = Astro.props.description ?? t.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title === "AgentZ Suite" ? title : `${title} - AgentZ Suite`}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={suiteIcon} />
    {home && <><link rel="alternate" hreflang="de" href={new URL("/", Astro.site)} /><link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site)} /><link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} /></>}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    <a class="skip-link btn" href="#content">{t.skip}</a>
    <Header lang={lang} home={home} />
    <main id="content"><slot /></main>
    <Footer lang={lang} home={home} />
    <script>import "../scripts/site";</script>
  </body>
</html>
