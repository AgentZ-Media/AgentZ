---
// A faithful, lightweight rebuild of the ScriptZ window. Rendered finished on
// the server; src/scripts/site.ts types the sketch again while it is visible.
import appIcon from "@agentz/design/assets/scriptz-app-icon.svg?url";
import Icon from "./Icon.astro";
import { catalogs, type Language } from "../i18n";
import { demoStats, formatTime } from "../scripts/demo-model";
interface Props { lang: Language }
const { lang } = Astro.props;
const d = catalogs[lang].demo;
const stats = demoStats(d.script);
const colorOf = new Map(stats.cast.map((c) => [c.name, c.color]));
const chips = { a: `${d.blockTypes[0]} ⌘1`, c: `${d.blockTypes[1]} ⌘2`, d: `${d.blockTypes[2]} ⌘3`, p: `${d.blockTypes[3]} ⌘4` };
const stageGlyphs = ["idea", "writing", "ready", "shot", "online"] as const;
const stageCounts = [4, 4, 2, 1, 2];
const folderCounts = [3, 1, 3, 6];
let speaker = "";
const pct = lang === "de" ? " %" : "%";
---
<div class="aw" data-theme="light" data-demo data-script={JSON.stringify(d.script)} data-chips={JSON.stringify(chips)} data-pct={pct} role="img" aria-label={catalogs[lang].hero.demoLabel}>
  <aside class="aw-side" aria-hidden="true">
    <div class="aw-lights"><i></i><i></i><i></i></div>
    <div class="aw-brand"><img src={appIcon} alt="" width="26" height="26" /><span>ScriptZ</span></div>
    <div class="aw-new"><Icon name="plus" />{d.newScript}<kbd>⌘N</kbd></div>
    <div class="aw-ida"><span class="aw-face"><i></i><i></i><i></i><i></i><i></i></span><span><b>Ida</b><small>{d.agentHint}</small></span><kbd>⌘L</kbd></div>
    <ul class="aw-nav">
      <li><Icon name="inbox" />{d.inbox}<span>11</span></li>
      <li><Icon name="stack" />{d.all}<span>9</span></li>
    </ul>
    <p class="aw-head">{d.pipeline}</p>
    <ul class="aw-nav">
      {d.stages.map((stage, i) => <li><Icon stage={stageGlyphs[i]} />{stage}<span>{stageCounts[i]}</span></li>)}
    </ul>
    <p class="aw-head">{d.folders}</p>
    <ul class="aw-nav">
      {d.folderNames.map((name, i) => <li><i class="aw-dot" style={`--dot: var(--char-${[4, 5, 2, 3][i]})`}></i>{name}<span>{folderCounts[i]}</span></li>)}
    </ul>
    <p class="aw-head">{d.open}</p>
    <ul class="aw-nav"><li class="is-on"><Icon stage="writing" />{d.title}</li></ul>
  </aside>

  <div class="aw-main">
    <div class="aw-top" aria-hidden="true">
      <span class="aw-crumb">{d.folder} <i>/</i> <b>{d.title}</b></span>
      <span class="aw-saved">{d.saved}</span>
      <span class="aw-pill"><Icon stage="writing" />{d.stage}<Icon name="down" /></span>
      <span class="aw-pill aw-hide-s"><Icon name="export" />{d.export}<kbd>⌘E</kbd></span>
      <span class="aw-pill aw-hide-s"><span class="aw-face aw-face-s"><i></i><i></i><i></i><i></i><i></i></span>Ida<kbd>⌘L</kbd></span>
    </div>
    <div class="aw-desk" data-demo-desk>
      <div class="aw-paper" data-demo-paper>
        {d.script.map(([kind, text]) => {
          if (kind === "c") speaker = text;
          const color = colorOf.get(speaker) ?? 0;
          return <p class={`blk blk-${kind}`} data-kind={kind} style={kind === "c" ? `--who: var(--char-${color})` : undefined}>{text}</p>;
        })}
      </div>
    </div>
    <div class="aw-timeline" aria-hidden="true">
      <span class="aw-tl-label"><Icon name="up" />{d.timeline}<kbd>⌘J</kbd></span>
      <span class="aw-tl-bar" data-demo-segments>
        {stats.segments.map((s) => <i style={`flex-grow:${s.weight};--seg:${s.color ? `var(--char-${s.color})` : "var(--line-strong)"}`}></i>)}
      </span>
      <b class="num" data-demo-time-small>{formatTime(stats.seconds)}</b>
    </div>
  </div>

  <aside class="aw-inspector" aria-hidden="true">
    <section>
      <p class="aw-cap">{d.stageLabel}</p>
      <span class="aw-steps"><i class="is-on"></i><i></i><i></i><i></i></span>
      <p class="aw-stage"><b>{d.stage}</b><span>{d.since}</span></p>
    </section>
    <section>
      <p class="aw-cap">{d.length}</p>
      <p class="aw-time num" data-demo-time>{formatTime(stats.seconds)}</p>
      <p class="aw-stats"><span><b class="num" data-demo-words>{stats.words}</b> {d.words}</span><span><b class="num" data-demo-dialog>{stats.dialogWords}</b> {d.inDialog}</span><span><b class="num" data-demo-switches>{stats.switches}</b> {d.switches}</span></p>
    </section>
    <section>
      <p class="aw-cap aw-cap-row"><span>{d.cast}</span><span>{d.share}</span></p>
      <ul class="aw-cast" data-demo-cast>
        {stats.cast.map((c) => (
          <li style={`--who: var(--char-${c.color})`} data-name={c.name}>
            <span class="aw-cast-name"><i></i>{c.name}<em class="num">{c.share}{pct}</em></span>
            <span class="aw-cast-bar"><i style={`width:${c.share}%`}></i></span>
          </li>
        ))}
      </ul>
    </section>
  </aside>
</div>
