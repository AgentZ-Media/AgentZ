---
import { apps, appLinks } from "../apps";
import { catalogs, type Language } from "../i18n";
import Icon from "./Icon.astro";
interface Props { lang: Language }
const { lang } = Astro.props;
const s = catalogs[lang].suite;
---
<div class="app-grid">
  {apps.map((app) => (
    <article class="app-card" data-reveal aria-labelledby={`app-${app.id}`}>
      <img class="app-icon" src={appLinks(app.id).icon} alt="" width="88" height="88" loading="lazy" />
      <div class="app-title"><h3 id={`app-${app.id}`}>{app.name}</h3><span class:list={["chip", { "chip-on": app.status === "available" }]}>{app.status === "available" ? s.available : s.soon}</span></div>
      <p>{app.tagline[lang]}</p>
      {app.id === "scriptz" && <a class="app-more" href="#scriptz">{s.open} {app.name}<Icon name="right" /></a>}
    </article>
  ))}
  <article class="app-card app-next" data-reveal>
    <svg class="app-next-mark" viewBox="0 0 50 70" aria-hidden="true">
      {Array.from({ length: 35 }, (_, i) => <circle cx={(i % 5) * 10 + 5} cy={Math.floor(i / 5) * 10 + 5} r="3.1" style={`--d:${(i * 7) % 11}`} />)}
    </svg>
    <div class="app-title"><h3>{s.next}</h3><span class="chip">{s.soon}</span></div>
    <p>{s.nextText}</p>
  </article>
</div>
