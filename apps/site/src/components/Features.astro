---
// ScriptZ features as small looping demos, rebuilt from the app's UI.
import Icon from "./Icon.astro";
import { catalogs, type Language } from "../i18n";
interface Props { lang: Language }
const { lang } = Astro.props;
const t = catalogs[lang];
const d = t.demo;
const f = t.features;
const [oma, jonas] = [d.script[1]![1], d.script[3]![1]];
const kinds = ["a", "c", "d", "p"] as const;
const samples = [d.script[0]![1], jonas, d.formatLine, d.script[6]![1]];
const stageGlyphs = ["idea", "writing", "ready", "shot", "online"] as const;
---
<div class="bento">
  <article class="tile tile-format" data-reveal>
    <div class="tile-copy"><h3>{f.format.title}</h3><p>{f.format.text}</p></div>
    <div class="demo-format" aria-hidden="true">
      <ul class="fmt-menu">
        {d.blockTypes.map((type, i) => <li style={`--i:${i}`}><span>{type}</span><kbd>⌘{i + 1}</kbd></li>)}
      </ul>
      <div class="fmt-paper">
        {kinds.map((kind, i) => (
          <div class={`fmt-layer blk blk-${kind}`} style={`--i:${i};--who: var(--char-2)`}>
            <span class="fmt-chip">{d.blockTypes[i]} ⌘{i + 1}</span>{samples[i]}<span class="caret"></span>
          </div>
        ))}
      </div>
    </div>
  </article>

  <article class="tile tile-runtime" data-reveal>
    <div class="tile-copy"><h3>{f.runtime.title}</h3><p>{f.runtime.text}</p></div>
    <div class="demo-runtime" data-runtime aria-hidden="true">
      <p class="rt-time num"><span>0:</span><span class="rt-count" data-runtime-count>38</span></p>
      <div class="rt-track"><span class="rt-goal"></span><span class="rt-fill"></span><span class="rt-knob"></span></div>
      <p class="rt-scale num"><span>0:00</span><span>{d.goal}</span><span>1:00</span></p>
    </div>
  </article>

  <article class="tile tile-timeline" data-reveal>
    <div class="tile-copy"><h3>{f.timeline.title}</h3><p>{f.timeline.text}</p></div>
    <div class="demo-timeline" aria-hidden="true">
      <div class="tl-grid">
        <span class="tl-hook"></span>
        <p class="tl-name" style="--who: var(--char-1)">{oma}</p>
        <span class="tl-track" style="--who: var(--char-1)"><i style="--x:8;--w:9;--k:1"></i><i style="--x:28;--w:7;--k:3"></i><i style="--x:47;--w:12;--k:5"></i><i style="--x:76;--w:8;--k:7"></i></span>
        <p class="tl-name" style="--who: var(--char-2)">{jonas}</p>
        <span class="tl-track" style="--who: var(--char-2)"><i style="--x:17;--w:11;--k:2"></i><i style="--x:62;--w:5;--k:6"></i><i style="--x:88;--w:6;--k:8"></i></span>
        <p class="tl-name">Action</p>
        <span class="tl-track tl-action"><i style="--x:0;--w:8;--k:0"></i><i style="--x:36;--w:10;--k:4"></i><i style="--x:69;--w:7;--k:6"></i></span>
        <span class="tl-head"></span>
      </div>
      <p class="tl-legend"><i></i>{d.hook}</p>
    </div>
  </article>

  <article class="tile tile-pipeline" data-reveal>
    <div class="tile-copy"><h3>{f.pipeline.title}</h3><p>{f.pipeline.text}</p></div>
    <div class="demo-pipeline" aria-hidden="true">
      <div class="pl-cols">
        {d.stages.map((stage, i) => <div class="pl-col" style={`--i:${i}`}><p><Icon stage={stageGlyphs[i]} /><span>{stage}</span></p><span class="pl-ghost"></span></div>)}
      </div>
      <div class="pl-card"><b>{d.title}</b><span><i></i>{d.folder}</span></div>
    </div>
  </article>

  <article class="tile tile-capture" data-reveal>
    <div class="tile-copy"><h3>{f.capture.title}</h3><p>{f.capture.text}</p></div>
    <div class="demo-capture" aria-hidden="true">
      <div class="cap-box">
        <Icon name="bulb" />
        <span class="cap-input"><span class="cap-ph">{d.ideaPlaceholder}</span><span class="cap-text">{d.idea}</span><span class="caret"></span></span>
        <kbd>↵</kbd>
      </div>
      <p class="cap-toast"><Icon name="check" />{d.ideaSaved}</p>
    </div>
  </article>

  <article class="tile tile-agent" data-reveal>
    <div class="tile-copy"><h3>{f.agent.title}</h3><p>{f.agent.text}</p></div>
    <div class="demo-agent" aria-hidden="true">
      <p class="ag-ask">{d.agentAsk}</p>
      <div class="ag-reply">
        <span class="aw-face ag-face"><i></i><i></i><i></i><i></i><i></i></span>
        <div>
          <p>{d.agentReply}</p>
          {d.agentOptions.map((option, i) => (
            <div class="ag-option" style={`--i:${i}`}>
              <span class="blk blk-c" style="--who: var(--char-1)">{oma}</span>
              <span class="blk blk-d">{option}</span>
              <span class="ag-insert"><Icon name="plus" />{d.insert}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </article>
</div>
