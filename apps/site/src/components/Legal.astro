---
import Base from "../layouts/Base.astro";
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<Base title={title} description={description}>
  <article class="legal">
    <nav class="legal-nav" aria-label="Rechtliche Informationen"><a href="/">Startseite</a><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></nav>
    <h1>{title}</h1>
    <slot />
  </article>
</Base>
