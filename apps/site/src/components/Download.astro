---
import { apps, appLinks } from "../apps";
import { catalogs, type Language } from "../i18n";
import Icon from "./Icon.astro";
interface Props { lang: Language }
const { lang } = Astro.props;
const t = catalogs[lang].download;
const app = apps.find((entry) => entry.id === "scriptz");
const links = app ? appLinks(app.id) : null;
const command = `xattr -cr "/Applications/${app?.name ?? "ScriptZ"}.app"`;
---
{app && links && app.status === "available" && (
  <div class="download-card" data-reveal>
    <div class="download-head">
      <img src={links.icon} alt="" width="96" height="96" loading="lazy" />
      <div><p class="kicker">{t.kicker}</p><h2 id="download-title">{t.title}</h2><p>{t.text}</p></div>
    </div>
    <div class="download-buttons" data-os-buttons>
      <a class="btn accent dl-btn" data-os="mac" href={links.macos}><Icon name="import" /><span>{t.macos}<small>{t.macosNote}</small></span></a>
      <a class="btn dl-btn" data-os="win" href={links.windows}><Icon name="import" /><span>{t.windows}<small>{t.windowsNote}</small></span></a>
    </div>
    <div class="download-notes">
      <p class="kicker">{t.firstRun}</p>
      <div class="note"><b>macOS</b><p>{t.macHint}</p><div class="cmd"><code>{command}</code><button class="btn" type="button" data-copy={command} data-copied={t.copied}>{t.copy}</button></div></div>
      <div class="note"><b>Windows</b><p>{t.winHint}</p></div>
      <a class="releases" href="https://github.com/AgentZ-Media/AgentZ-Suite/releases">{t.releases}<Icon name="right" /></a>
    </div>
  </div>
)}
