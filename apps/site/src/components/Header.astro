---
import suiteIcon from "@agentz/design/assets/suite-app-icon.svg?url";
import Icon from "./Icon.astro";
import { accountPaths, catalogs, scriptzPaths, type Language, type PagePaths } from "../i18n";
interface Props { lang: Language; paths?: PagePaths }
const { lang, paths } = Astro.props;
const t = catalogs[lang];
const base = lang === "en" ? "/en/" : "/";
const other = lang === "en" ? { code: "DE", lang: "de", name: "Deutsch" } as const : { code: "EN", lang: "en", name: "English" } as const;
const account = accountPaths[lang];
---
<header class="site-header">
  <a class="brand" href={base} aria-label={`AgentZ Suite - ${t.home}`}>
    <img src={suiteIcon} alt="" width="30" height="30" />
    <span>AgentZ <span class="brand-suite">Suite</span></span>
  </a>
  <nav class="header-nav" aria-label="AgentZ Suite">
    <a href={scriptzPaths[lang]}>{t.nav.scriptz}</a>
    <a href={`${base}#apps`}>{t.nav.apps}</a>
    <a class="hide-s" href="https://github.com/AgentZ-Media/AgentZ-Suite">{t.nav.source}</a>
  </nav>
  <div class="header-end">
    {paths && <a class="lang-switch" href={paths[other.lang]} hreflang={other.lang} lang={other.lang} aria-label={`${t.language}: ${other.name}`}>{other.code}</a>}
    <a class="header-account" href={account} aria-current={Astro.url.pathname === account ? "page" : undefined}><Icon name="users" /><span>{t.nav.account}</span></a>
    <a class="btn accent header-cta" href={`${base}#download`}>{t.nav.download}</a>
  </div>
</header>
