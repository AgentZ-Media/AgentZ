{
  "name": "@agentz/design",
  "private": true,
  "version": "0.0.0",
  "description": "AgentZ suite design system: semantic tokens, legacy aliases, component primitives, fonts, icons and the logo mark.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./legacy.css": "./legacy.css",
    "./components.css": "./components.css",
    "./fonts.css": "./fonts.css",
    "./icons": "./icons.ts",
    "./logo": "./logo.ts",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:logo": "node scripts/build-logo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "~5.6.2"
  }
}
