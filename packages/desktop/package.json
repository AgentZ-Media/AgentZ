{
  "name": "@agentz/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Shared Tauri host for AgentZ desktop apps.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./index.ts"
  ],
  "exports": {
    ".": "./index.ts",
    "./vite": "./vite.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentz/design": "workspace:*",
    "@agentz/kit": "workspace:*",
    "solid-js": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-deep-link": "catalog:",
    "@tauri-apps/plugin-dialog": "catalog:",
    "@tauri-apps/plugin-fs": "catalog:",
    "@tauri-apps/plugin-opener": "catalog:",
    "@tauri-apps/plugin-os": "catalog:",
    "@tauri-apps/plugin-process": "catalog:",
    "@tauri-apps/plugin-sql": "catalog:",
    "@tauri-apps/plugin-updater": "catalog:"
  },
  "devDependencies": {
    "@agentz/vitest-preset": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
