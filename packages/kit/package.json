{
  "name": "@agentz/kit",
  "private": true,
  "version": "0.0.0",
  "description": "Shared application shell and product-neutral Solid components.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./i18n": "./i18n/index.ts",
    "./platform": "./platform/index.ts",
    "./stores": "./stores/index.ts",
    "./lib": "./lib/index.ts",
    "./ui": "./ui/index.ts",
    "./styles.css": "./styles.css",
    "./shell": "./shell/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fixture": "vite --config __tests__/fixtures/vite.config.ts"
  },
  "dependencies": {
    "@agentz/design": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@agentz/vitest-preset": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
