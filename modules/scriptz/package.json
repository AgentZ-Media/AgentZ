{
  "name": "@agentz/scriptz",
  "private": true,
  "version": "0.0.0",
  "description": "ScriptZ product module: editor, application logic, stores and UI.",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./i18n": "./i18n/index.ts",
    "./i18n/*": "./i18n/*.ts",
    "./lib/*": "./lib/*.ts",
    "./stores/*": "./stores/*.ts",
    "./components/*.css": "./components/*.css",
    "./components/*": "./components/*.tsx",
    "./styles/*.css": "./styles/*.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentz/design": "workspace:*",
    "@lexical/history": "catalog:",
    "@lexical/rich-text": "catalog:",
    "@lexical/utils": "catalog:",
    "@pdf-lib/fontkit": "catalog:",
    "lexical": "catalog:",
    "pdf-lib": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@solidjs/testing-library": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:",
    "@agentz/vitest-preset": "workspace:*"
  }
}
