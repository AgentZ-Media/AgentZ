{
  "name": "@scriptz/core",
  "private": true,
  "version": "0.0.0",
  "description": "Shared editor, business logic and UI for ScriptZ Desktop and (future) Web apps.",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./i18n": "./i18n/index.ts",
    "./i18n/*": "./i18n/*.ts",
    "./lib/*": "./lib/*.ts",
    "./stores/*": "./stores/*.ts",
    "./components/*.css": "./components/*.css",
    "./components/*": "./components/*.tsx",
    "./styles/*.css": "./styles/*.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentz/design": "workspace:*",
    "@lexical/history": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "lexical": "^0.44.0",
    "pdf-lib": "^1.17.1",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.8"
  }
}
